diff --git a/prompt_hr/overrides/salary_slip_override.py b/prompt_hr/overrides/salary_slip_override.py
index 60df58a..e712925 100644
--- a/prompt_hr/overrides/salary_slip_override.py
+++ b/prompt_hr/overrides/salary_slip_override.py
@@ -20,6 +20,52 @@ class CustomSalarySlip(SalarySlip):
     def __init__(self, *args, **kwargs):
         super().__init__(*args, **kwargs)
 
+    # ? SALARY STRUCTURE DOC USED BY THE OVERRIDES BELOW
+    # ! hrms used to stash the Salary Structure document on the slip while computing
+    # ! (self._salary_structure_doc = frappe.get_cached_doc(...)). hrms 16 removed it entirely —
+    # ! components now resolve from the Salary Structure Assignment via _evaluated_components —
+    # ! but calculate_net_pay, compute_income_tax_breakup and
+    # ! evaluate_and_update_structure_formula below still read it, so every Salary Slip
+    # ! computation died with "AttributeError: 'CustomSalarySlip' object has no attribute
+    # ! '_salary_structure_doc'". Rebuild it lazily, the same way old hrms did.
+    @property
+    def _salary_structure_doc(self):
+        cached = self.__dict__.get("_ss_structure_doc")
+        if cached is None and self.get("salary_structure"):
+            cached = self._build_structure_snapshot(self.get("salary_structure"))
+            self.__dict__["_ss_structure_doc"] = cached
+        return cached
+
+    @staticmethod
+    def _build_structure_snapshot(salary_structure):
+        """Salary Structure rows in the shape hrms 16 expects when evaluating a formula.
+
+        hrms 16's eval_condition_and_formula is written for a row already resolved from the
+        Salary Structure Assignment: its condition/formula are single-line and its `precision`
+        is a plain int. A raw Salary Structure child row is neither — the formula still has the
+        newlines the author typed (which raises SyntaxError, e.g. "expected 'else' after 'if'"),
+        and `precision` is a bound method. So snapshot the rows into plain dicts with both
+        normalised. A snapshot also means nothing here can mutate the cached Salary Structure.
+        """
+        from hrms.payroll.utils import sanitize_expression
+
+        structure = frappe.get_cached_doc("Salary Structure", salary_structure)
+        snapshot = frappe._dict({"name": structure.name})
+        for section in ("earnings", "deductions"):
+            rows = []
+            for row in structure.get(section) or []:
+                normalised = frappe._dict(row.as_dict())
+                normalised.condition = sanitize_expression(row.get("condition"))
+                normalised.formula = sanitize_expression(row.get("formula"))
+                normalised.precision = row.precision("amount")
+                rows.append(normalised)
+            snapshot[section] = rows
+        return snapshot
+
+    @_salary_structure_doc.setter
+    def _salary_structure_doc(self, value):
+        self.__dict__["_ss_structure_doc"] = value
+
     def validate(self):
         self.check_salary_withholding()
         self.status = self.get_status()
